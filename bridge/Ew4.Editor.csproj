<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.4.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RewriteSnapshot Condition="'$(RewriteSnapshot)' == '' And Exists('$(MSBuildProjectDirectory)/../.local/r3-20261107/baseline.json')">$(MSBuildProjectDirectory)/../.local/r3-20261107/rewrite</RewriteSnapshot>
    <RewriteSnapshot Condition="'$(RewriteSnapshot)' == '' And Exists('$(MSBuildProjectDirectory)/../.local/r3/baseline.json')">$(MSBuildProjectDirectory)/../.local/r3/rewrite</RewriteSnapshot>
    <RewriteSnapshot Condition="'$(RewriteSnapshot)' == ''">$(MSBuildProjectDirectory)/../.local/rewrite</RewriteSnapshot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../dist/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="$(RewriteSnapshot)/Ew4.Client/Ew4.Client.csproj" />
    <Compile Include="$(RewriteSnapshot)/Ew4.Mods/*.cs" Link="Rewrite/Mods/%(Filename)%(Extension)" />
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.3" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>
</Project>
