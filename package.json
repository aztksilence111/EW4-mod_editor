{
  "name": "ew4-rewrite-mod-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node tools/setup.mjs",
    "dev": "node tools/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:bridge": "dotnet build bridge/Ew4.Editor.csproj -v:q",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "papaparse": "^5.7.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vue-tsc": "^2.1.0"
  }
}
