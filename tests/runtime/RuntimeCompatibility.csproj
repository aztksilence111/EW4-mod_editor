<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BridgeOutput>$(MSBuildProjectDirectory)/../../bridge/bin/Debug/net10.0</BridgeOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Ew4.Editor" HintPath="$(BridgeOutput)/Ew4.Editor.dll" />
    <Reference Include="Ew4.Client" HintPath="$(BridgeOutput)/Ew4.Client.dll" />
    <Reference Include="Ew4.Core" HintPath="$(BridgeOutput)/Ew4.Core.dll" />
    <Reference Include="Ew4.Legacy" HintPath="$(BridgeOutput)/Ew4.Legacy.dll" />
    <Reference Include="Ew4.Persistence" HintPath="$(BridgeOutput)/Ew4.Persistence.dll" />
    <Compile Include="../../bridge/BattleReferenceValidation.cs" Link="BattleReferenceValidation.cs" />
  </ItemGroup>
</Project>
